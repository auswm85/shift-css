FROM mcr.microsoft.com/playwright:v1.63.0-jammy

# Create non-root user
RUN useradd --create-home --shell /bin/bash playwright

# Install dependencies for Bun
RUN apt-get update && apt-get install -y unzip && rm -rf /var/lib/apt/lists/*

# Install Bun
ENV BUN_INSTALL=/usr/local
RUN curl -fsSL https://bun.sh/install | bash

WORKDIR /app

# Copy all package files for proper workspace resolution
COPY package.json bun.lock ./
COPY packages/core/package.json ./packages/core/
COPY apps/docs/package.json ./apps/docs/

# Install dependencies (skip frozen for cross-platform compatibility)
RUN bun install

# Install the browser binary matching the locked Playwright version.
# Uses the locally installed playwright from the lockfile, not bunx (which
# would download the latest version with a potentially different Chromium
# revision). The base image ships browsers pinned to its tag, which drifts
# out of sync whenever Dependabot bumps @playwright/test.
RUN packages/core/node_modules/.bin/playwright install chromium

# Copy source
COPY . .

# Build
RUN bun run build

RUN chown -R playwright:playwright /app /ms-playwright
USER playwright

# Default command
CMD ["bun", "run", "--cwd", "packages/core", "test:visual"]